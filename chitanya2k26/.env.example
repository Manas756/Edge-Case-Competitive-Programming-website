# ---- Organizer access (server-side only, never shown in the UI) ----
ORGANIZER_KEY=manas
# Long random string used to sign session cookies.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---- Judge ----
# "simulated" = UI demo only. It does NOT run code; verdicts are placeholders.
# "judge0"    = real sandboxed execution through a Judge0 server.
JUDGE_PROVIDER=simulated
JUDGE0_URL=http://localhost:2358
# Only for hosted Judge0 on RapidAPI:
JUDGE0_API_KEY=
JUDGE0_API_HOST=
# Only if your Judge0 instance has AUTHN enabled:
JUDGE0_AUTH_TOKEN=
# Optional: override Judge0 language ids, e.g. {"cpp":54,"python":71}
JUDGE0_LANGUAGE_IDS=

# ---- Misc ----
# Shown as a hint on the Join page. Remove to hide it.
NEXT_PUBLIC_DEMO_CODE=Chaitanya2k26
# JSON data store location (swap src/lib/store.ts for a real DB later).
DATA_FILE=./data/db.json
